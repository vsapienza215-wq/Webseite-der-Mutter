# SAPiENZA – Server-Einstellungen (Apache)

Options -Indexes
ErrorDocument 404 /404.html

# Zugangsdaten und Fehlerprotokoll niemals ausliefern
<FilesMatch "^(kontakt-config\.php|kontakt-fehler\.log|gate-config(\.beispiel)?\.php)$">
  Require all denied
</FilesMatch>
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen (aktivieren, sobald das SSL-Zertifikat eingerichtet ist)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ===== Passwortschutz (vor dem Livegang) – zum Livegang diesen Block löschen =====
  # Alle Aufrufe laufen durch gate.php; ohne Anmeldung erscheint nur die Login-Seite.
  RewriteCond %{REQUEST_URI} !^/gate\.php$
  RewriteCond %{REQUEST_URI} !^/assets/css/gate\.css$
  RewriteCond %{REQUEST_URI} !^/assets/img/logo\.svg$
  RewriteCond %{REQUEST_URI} !^/assets/fonts/
  RewriteCond %{REQUEST_URI} !^/(favicon\.svg|apple-touch-icon\.png)$
  RewriteRule ^ /gate.php [L]
  # ===== Ende Passwortschutz =====
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# CSP nur für Seiten – sonst blockiert sie die XML-Ansicht des Browsers (sitemap.xml)
<FilesMatch "\.(html|php)$">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/xml .xml
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<FilesMatch "\.(woff2)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
